rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      // 1. Allow profile creation if authenticated and UID matches Document ID
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // 2. Allow user to read/update/delete ONLY their own profile
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;

      // 3. Allow public listing of users for the Leaderboard safely
      // (This is required to fetch top XP without exposing private edits)
      allow list: if request.auth != null;
    }

    // ==========================================
    // SUBMISSIONS COLLECTION
    // ==========================================
    match /submissions/{submissionId} {
      // 1. Allow creation only if the payload's userId matches the authenticated user
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      
      // 2. Allow reading/updating ONLY if the existing document's userId matches the authenticated user
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ==========================================
    // PROBLEMS COLLECTION
    // ==========================================
    match /problems/{problemId} {
      // Public data: Readable by anyone, but writable only by admins (or blocked entirely here)
      allow read: if true;
      allow write: if false; 
    }

    // ==========================================
    // COMMUNITY COLLECTION
    // ==========================================
    match /community/{postId} {
      // 1. Readable by all
      allow read: if true;

      // 2. Writable (Create) only if authenticated and payload's userId matches
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;

      // 3. Update/Delete only by the original author
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    // ==========================================
    // TEST COLLECTION
    // ==========================================
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
